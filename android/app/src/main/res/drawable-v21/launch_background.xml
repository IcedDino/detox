<?xml version="1.0" encoding="utf-8"?>
<!-- Detox launch screen for API 21 and up. Both files must stay identical:
     drawable-v21 wins on every device this app supports (minSdk 24), while a
     dark device picks drawable-night/ if one is ever added.
     See drawable/launch_background.xml for the colour resolution. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_symbol" />
    </item>
</layer-list>
