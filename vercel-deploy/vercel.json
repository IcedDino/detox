{
  "buildCommand": "echo 'static site'",
  "outputDirectory": "web",
  "framework": null,
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/aviso-de-privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos-y-condiciones.html"
    },
    {
      "source": "/eliminar-cuenta",
      "destination": "/delete-account.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}